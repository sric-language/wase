name = waseDemoQt
summary = sric GUI library demo
outType = exe
version = 1.0
depends = waseGui 1.0, Qt 6
srcDirs = ./,../,../../../sric/output/waseDemo.cpp
incDirs = ./,../
msvc.extConfigs.cppflags = /std:c++17 /Zc:__cplusplus /permissive-
gcc.extConfigs.cppflags = -std=c++17
win32-gcc.extLibs = opengl32,gdi32,winmm
win32.excludeSrc = .*(Glfw|Nanovg).*